#!/data/data/com.termux/files/usr/bin/bash
# managed by opencode-unlimited-warp
#
# No args + interactive terminal -> launcher menu (1 = opencode, 2 = status)
# Any args (run / serve / --version ...) -> straight through the WARP lane.
# Bypass the menu once with:  OC_MENU_SKIP=1 opencode
# If the lane runtime is missing, fall back to the stock opencode binary so
# `opencode` never dies with "not found" after a wipe/uninstall.
DEST="${OUC_WARP_DEST:-$HOME/.local/share/opencode-unlimited-warp}"

if [ ! -f "$DEST/scripts/lane.sh" ]; then
  REAL=""
  # Same precedence as the lane: pin (oc-ver), plain entry, then versioned builds.
  if [ -f "$DEST/active-bin" ]; then
    IFS= read -r c < "$DEST/active-bin" || c=""
    [ -n "$c" ] && [ -x "$c" ] && REAL="$c"
  fi
  if [ -z "$REAL" ]; then
    for c in "${PREFIX:-/data/data/com.termux/files/usr}/bin/opencode" \
             "$HOME/.opencode/bin/opencode"; do
      if [ -x "$c" ] && [ "$(readlink -f "$c" 2>/dev/null)" != "$(readlink -f "$0" 2>/dev/null)" ]; then
        REAL="$c"
        break
      fi
    done
  fi
  if [ -z "$REAL" ]; then
    for c in "${PREFIX:-/data/data/com.termux/files/usr}/bin"/opencode-[0-9]*; do
      [ -x "$c" ] && REAL="$c"
    done
  fi
  if [ -n "$REAL" ]; then
    printf '[!] warp lane missing (%s)\n    stock opencode chal raha hai — repair: bash install-warp-lane.sh\n' "$DEST" >&2
    exec "$REAL" "$@"
  fi
  printf '[x] opencode not found — install karo: pkg install opencode\n' >&2
  exit 127
fi

if [ "$#" -eq 0 ] && [ -t 0 ] && [ -t 1 ] && [ -z "${OC_MENU_SKIP:-}" ] && [ -f "$DEST/scripts/menu.sh" ]; then
  exec bash "$DEST/scripts/menu.sh"
fi

exec bash "$DEST/scripts/lane.sh" "$@"
